# Node / build artifacts
node_modules/
/scoreview/js/
vendor/
*.log

# Werkzeug-Caches und lokale Umgebungen
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.eslintcache
.stylelintcache
.venv/
__pycache__/
.pytest_cache/

# Testpartituren sind nicht garantiert frei lizenziert - nie stillschweigend
# committen. Siehe sidecar/testdata/README.md.
sidecar/testdata/*.mscz
sidecar/testdata/*.mp3
sidecar/testdata/*.wav
sidecar/testdata/*.mid
sidecar/testdata/*.musicxml
sidecar/testdata/*.spos
sidecar/testdata/*.mpos

# Ausnahme: selbst erstellte, lizenzklare Testpartitur (Wiederholung, Volta,
# D.C.) - Vorlage fuer selftest-score.mscz.
!sidecar/testdata/repeat-test.mscz
!sidecar/testdata/repeat-test.musicxml

# Signaturmaterial der App: der private Schluessel darf NIE ins Repo, und
# signature.json entsteht je Release neu (siehe docs/development.md).
*.key
*.crt
*.csr
scoreview/appinfo/signature.json


{
	"name": "scoreview/scoreview",
	"description": "ScoreView für Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.3",
		"nextcloud/ocp": "^31.0",
		"phpunit/phpunit": "^13.4"
	},
	"autoload": {
		"psr-4": {
			"OCA\\ScoreView\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\ScoreView\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		},
		"files": [
			"tests/stubs/OCHooksEmitter.php",
			"tests/stubs/OCServer.php"
		]
	},
	"scripts": {
		"test:unit": "phpunit --config tests/phpunit.xml --testsuite unit",
		"test:sandbox": "phpunit --config tests/phpunit.xml --testsuite sandbox",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"php-http/discovery": false
		},
		"sort-packages": true
	}
}

#: lib/Controller/AnnotationController.php
msgid "You do not have permission to create shared notes for this file."
msgstr "Du hast keine Berechtigung, geteilte Notizen für diese Datei anzulegen."

#: lib/Controller/AnnotationController.php
msgid "Only leaders can address notes to voices."
msgstr "Nur Leitungen können Notizen an Stimmen richten."

#: lib/Controller/AnnotationController.php lib/Controller/RecordingController.php src/components/LoopSaveForm.vue src/components/ScoreAnnotations.vue
msgid "Choose at least one voice."
msgstr "Wähle mindestens eine Stimme."

#: lib/Controller/AnnotationController.php
msgid "You already have the maximum number of notes for this score. Delete some notes first."
msgstr "Du hast bereits die höchstmögliche Zahl an Notizen zu dieser Partitur. Lösche zuerst einige Notizen."

#: lib/Controller/AnnotationController.php
msgid "Note must not be empty."
msgstr "Notiz darf nicht leer sein."

#: lib/Controller/AnnotationController.php
msgid "You do not have permission to change this note."
msgstr "Du hast keine Berechtigung, diese Notiz zu ändern."

#: lib/Controller/AnnotationController.php
msgid "Note not found or no access."
msgstr "Notiz nicht gefunden oder kein Zugriff."

#: lib/Controller/AnnotationController.php
msgid "Note is too long."
msgstr "Notiz ist zu lang."

#: lib/Controller/AnnotationController.php
msgid "A loop needs an end measure at or after its start."
msgstr "Ein Loop braucht einen Endtakt an oder nach seinem Anfang."

#: lib/Controller/AnnotationController.php
msgid "Invalid drawing."
msgstr "Ungültige Zeichnung."

#: lib/Controller/AnnotationController.php
msgid "Unknown stamp."
msgstr "Unbekannter Stempel."

#: lib/Controller/AnnotationController.php
msgid "Invalid note anchor."
msgstr "Ungültiger Notizanker."

#: lib/Controller/ConversionController.php lib/Controller/JsonErrors.php lib/Controller/SetlistController.php lib/Controller/VariantController.php
msgid "File not found or no access."
msgstr "Datei nicht gefunden oder kein Zugriff."

#: lib/Controller/ConversionController.php
msgid "Not allowed to convert this score again."
msgstr "Diese Partitur darf nicht neu konvertiert werden."

#: lib/Controller/ConversionController.php lib/Controller/EngineController.php lib/Controller/VariantController.php
msgid "Requested file does not exist."
msgstr "Angeforderte Datei existiert nicht."

#: lib/Controller/ConversionController.php lib/Controller/VariantController.php
msgid "Conversion not finished yet."
msgstr "Konvertierung noch nicht fertig."

#: lib/Controller/FollowController.php lib/Controller/LeaderController.php
msgid "Only leaders of this score can do that."
msgstr "Das dürfen nur Leitungen dieser Partitur."

#: lib/Controller/FollowController.php
msgid "No “Follow me” session is running for this score."
msgstr "Für diese Partitur läuft keine „Folgt mir“-Sitzung."

#: lib/Controller/FollowController.php
msgid "Another leader is leading this session. Take it over first."
msgstr "Eine andere Leitung leitet diese Sitzung. Übernimm sie zuerst."

#: lib/Controller/FollowController.php
msgid "This position or loop does not exist."
msgstr "Diese Position oder dieser Loop existiert nicht."

#: lib/Controller/FollowController.php
msgid "Another leader changed the session at the same moment. Please try again."
msgstr "Eine andere Leitung hat die Sitzung im selben Moment geändert. Bitte erneut versuchen."

#: lib/Controller/JsonErrors.php
msgid "A file with this name already exists."
msgstr "Eine Datei mit diesem Namen gibt es schon."

#: lib/Controller/JsonErrors.php lib/Controller/PdfController.php
msgid "You cannot save files in this folder."
msgstr "In diesem Ordner darfst du keine Dateien speichern."

#: lib/Controller/JsonErrors.php
msgid "Not enough storage space."
msgstr "Nicht genug Speicherplatz."

#: lib/Controller/JsonErrors.php
msgid "The file or folder is in use right now. Try again in a moment."
msgstr "Die Datei oder der Ordner wird gerade benutzt. Bitte gleich noch einmal versuchen."

#: lib/Controller/JsonErrors.php
msgid "Invalid file name or folder."
msgstr "Ungültiger Dateiname oder Ordner."

#: lib/Controller/LeaderController.php
msgid "Only people who can open this score can lead it."
msgstr "Leiten kann nur, wer diese Partitur öffnen darf."

#: lib/Controller/LeaderController.php
msgid "The owner always leads the score and cannot be removed."
msgstr "Wem die Datei gehört, leitet die Partitur immer und kann nicht abberufen werden."

#: lib/Controller/LeaderController.php
msgid "This person is not a leader of this score."
msgstr "Diese Person ist keine Leitung dieser Partitur."

#: lib/Controller/PageController.php
msgid "The offline page is turned off on this server."
msgstr "Die Offline-Seite ist auf diesem Server ausgeschaltet."

#: lib/Controller/PageController.php
msgid "ScoreView offline"
msgstr "ScoreView offline"

#: lib/Controller/PdfController.php lib/Controller/PracticeTrackController.php
msgid "Saving here is not possible from the mobile app."
msgstr "Von der Mobil-App aus lässt sich hier nicht speichern."

#: lib/Controller/PdfController.php
msgid "This is not a PDF file."
msgstr "Das ist keine PDF-Datei."

#: lib/Controller/PdfController.php
msgid "The PDF file is larger than allowed ({mb} MB)."
msgstr "Die PDF-Datei ist größer als erlaubt ({mb} MB)."

#: lib/Controller/PracticeLogController.php
msgid "Invalid practice time."
msgstr "Ungültige Übezeit."

#: lib/Controller/PracticeLogController.php
msgid "Only leaders can set a practice goal."
msgstr "Nur Leitungen können ein Übeziel setzen."

#: lib/Controller/PracticeTrackController.php
msgid "This is not an MP3 file."
msgstr "Das ist keine MP3-Datei."

#: lib/Controller/PracticeTrackController.php
msgid "The practice track is larger than allowed ({mb} MB)."
msgstr "Der Übe-Track ist größer als erlaubt ({mb} MB)."

#: lib/Controller/PreferenceController.php
msgid "Not logged in."
msgstr "Nicht angemeldet."

#: lib/Controller/RecordingController.php
msgid "Only leaders can share recordings with voices."
msgstr "Nur Leitungen können Aufnahmen für Stimmen freigeben."

#: lib/Controller/RecordingController.php
msgid "The recording is longer than the %s minutes allowed on this server."
msgstr "Die Aufnahme ist länger als die %s Minuten, die dieser Server erlaubt."

#: lib/Controller/RecordingController.php
msgid "The recording is longer than the %s seconds allowed on this server."
msgstr "Die Aufnahme ist länger als die %s Sekunden, die dieser Server erlaubt."

#: lib/Controller/RecordingController.php
msgid "This is not a recording made with ScoreView."
msgstr "Das ist keine Aufnahme aus ScoreView."

#: lib/Controller/RecordingController.php
msgid "You already have the maximum number of recordings for this score. Replace the oldest one or delete one first."
msgstr "Du hast schon die größte erlaubte Zahl an Aufnahmen dieser Partitur. Ersetze die älteste oder lösche vorher eine."

#: lib/Controller/RecordingController.php
msgid "Your recordings use all the storage allowed per person. Delete older recordings first."
msgstr "Deine Aufnahmen belegen den ganzen Speicher, der je Person erlaubt ist. Lösche zuerst ältere Aufnahmen."

#: lib/Controller/RecordingController.php
msgid "The storage for recordings on this server is full. Please tell your administrator."
msgstr "Der Speicher für Aufnahmen auf diesem Server ist voll. Bitte gib der Administration Bescheid."

#: lib/Controller/RecordingController.php
msgid "Recording not found."
msgstr "Aufnahme nicht gefunden."

#: lib/Controller/SetlistController.php
msgid "You are not allowed to change this setlist."
msgstr "Du darfst diese Setliste nicht ändern."

#: lib/Controller/SetlistController.php
msgid "The setlist was changed in the meantime. Please reload it and try again."
msgstr "Die Setliste wurde inzwischen geändert. Bitte neu laden und erneut versuchen."

#: lib/Controller/SetlistController.php
msgid "A setlist with this name already exists."
msgstr "Eine Setliste mit diesem Namen gibt es schon."

#: lib/Controller/SetlistController.php
msgid "The file is too large for a setlist."
msgstr "Die Datei ist zu groß für eine Setliste."

#: lib/Controller/SetlistController.php src/components/SetlistEditor.vue
msgid "The setlist could not be saved."
msgstr "Die Setliste konnte nicht gespeichert werden."

#: lib/Controller/SettingsController.php
msgid "Only administrators can change the Node.js path, the conversion service and the SoundFont source."
msgstr "Nur Administratoren können den Node.js-Pfad, den Konvertierungsdienst und die SoundFont-Quelle ändern."

#: lib/Controller/SettingsController.php
msgid "The path must be empty or an absolute path to a program named node, nodejs or deno."
msgstr "Der Pfad muss leer sein oder absolut auf ein Programm namens node, nodejs oder deno zeigen."

#: lib/Controller/SettingsController.php
msgid "Addresses for the conversion service and the SoundFont source must start with http:// or https://."
msgstr "Adressen für den Konvertierungsdienst und die SoundFont-Quelle müssen mit http:// oder https:// beginnen."

#: lib/Controller/SingRunController.php
msgid "Invalid singing result."
msgstr "Ungültiges Singergebnis."

#: lib/Controller/SoundFontController.php
msgid "The server could not provide the SoundFont. The ScoreView status in the administration settings shows why."
msgstr "Der Server konnte das SoundFont nicht bereitstellen. Warum, zeigt der Status von ScoreView in den Verwaltungseinstellungen."

#: lib/Controller/VariantController.php
msgid "This score has no such part."
msgstr "Diese Partitur hat keine solche Stimme."

#: lib/Search/ScoreSearchProvider.php
msgid "Scores"
msgstr "Partituren"

#: lib/Service/HealthService.php
msgid "PHP is not allowed to start processes (proc_open is blocked by disable_functions)."
msgstr "PHP darf keine Prozesse starten (proc_open ist per disable_functions gesperrt)."

#: lib/Service/HealthService.php
msgid "No Node.js runtime found. Enter its path in the settings."
msgstr "Keine Node.js-Laufzeit gefunden. Pfad in den Einstellungen eintragen."

#: lib/Service/HealthService.php
msgid "Deno {version} is too old; Deno 2 or newer is required."
msgstr "Deno {version} ist zu alt; nötig ist Deno 2 oder neuer."

#: lib/Service/HealthService.php
msgid "The engine package (scoreview-engine) is missing next to the converter (converter/node_modules)."
msgstr "Das Engine-Paket (scoreview-engine) fehlt neben dem Konverter (converter/node_modules)."

#: lib/Service/PracticeTrackService.php
msgid "Practice tracks"
msgstr "Übe-Tracks"

#: lib/Settings/Section.php src/components/AdminSettings.vue
msgid "ScoreView"
msgstr "ScoreView"

#: src/components/AdminSettings.vue
msgid "How scores are converted into pages, MIDI and timing data. Both ways produce the same result; they differ in what the server needs."
msgstr "Wie Partituren in Seiten, MIDI und Timing-Daten übersetzt werden. Beide Wege liefern dasselbe Ergebnis; sie unterscheiden sich darin, was der Server dafür braucht."

#: src/components/AdminSettings.vue
msgid "On this server, without a container (MuseScore as WebAssembly, needs Node.js) – default"
msgstr "Auf diesem Server, ohne Container (MuseScore als WebAssembly, braucht Node.js) – Voreinstellung"

#: src/components/AdminSettings.vue
msgid "Sidecar container (conversion in its own container)"
msgstr "Sidecar-Container (Konvertierung in einem eigenen Container)"

#: src/components/AdminSettings.vue
msgid "Only administrators can change the sidecar connection, the path to node and the SoundFont download URL."
msgstr "Nur Administratoren können die Sidecar-Verbindung, den Pfad zu node und die SoundFont-Download-Adresse ändern."

#: src/components/AdminSettings.vue
msgid "Sidecar URL"
msgstr "Sidecar-URL"

#: src/components/AdminSettings.vue
msgid "Shared secret"
msgstr "Shared Secret"

#: src/components/AdminSettings.vue
msgid "Leave empty to keep the current secret."
msgstr "Leer lassen, um das bisherige Secret zu behalten."

#: src/components/AdminSettings.vue
msgid "Convert with"
msgstr "Konvertieren mit"

#: src/components/AdminSettings.vue
msgid "scoreview-engine – everything the local path offers: highlighted notes, lyrics view, note names, parts and phone pages – default"
msgstr "scoreview-engine – alles, was der lokale Weg bietet: hervorgehobene Noten, Liedtextansicht, Tonnamen, Stimmenauszüge und Handyseiten – Voreinstellung"

#: src/components/AdminSettings.vue
msgid "MuseScore itself – the original music font of old scores and SVG images in the score, without those features"
msgstr "MuseScore selbst – Originalnotenschrift alter Partituren und SVG-Bilder in der Partitur, ohne diese Funktionen"

#: src/components/AdminSettings.vue
msgid "The engine needs a sidecar image built with ScoreView 1.24 or later; the self-test below says whether yours has it."
msgstr "Die Engine braucht ein Sidecar-Image ab ScoreView 1.24; ob deines sie hat, zeigt der Selbsttest unten."

#: src/components/AdminSettings.vue
msgid "Path to node or deno (optional)"
msgstr "Pfad zu node oder deno (optional)"

#: src/components/AdminSettings.vue
msgid "Leave empty to search the usual locations for node. Node.js 18 or newer or Deno 2 or newer is required, and PHP must be allowed to start processes."
msgstr "Leer lassen, um an den üblichen Orten nach node zu suchen. Nötig ist Node.js 18 oder neuer oder Deno 2 oder neuer, und PHP muss Prozesse starten dürfen."

#: src/components/AdminSettings.vue
msgid "Convert new/changed scores immediately (instead of on first open)"
msgstr "Neue/geänderte Partituren sofort konvertieren (statt erst beim ersten Öffnen)"

#: src/components/AdminSettings.vue
msgid "Without effect right now: scores are converted in the browser, and nothing is stored on the server that could be prepared in advance."
msgstr "Derzeit ohne Wirkung: Partituren werden im Browser gesetzt, und auf dem Server wird nichts abgelegt, was sich vorab vorbereiten liesse."

#: src/components/AdminSettings.vue
msgid "SoundFont download URL (SF2/SF3, optional)"
msgstr "SoundFont-Download-URL (SF2/SF3, optional)"

#: src/components/AdminSettings.vue
msgid "Leave empty for the default (FluidR3Mono_GM, about 23 MB). Without a sidecar there is no SoundFont on the server, so the server downloads this file once and then delivers it itself - the address only needs to be reachable from the server, and needs no CORS."
msgstr "Leer lassen für die Voreinstellung (FluidR3Mono_GM, rund 23 MB). Ohne Sidecar liegt auf dem Server kein SoundFont, der Server lädt diese Datei deshalb einmalig und liefert sie danach selbst aus – die Adresse muss nur vom Server aus erreichbar sein und kein CORS erlauben."

#: src/components/AdminSettings.vue
msgid "Custom SoundFont URL (SF2/SF3, optional)"
msgstr "Eigene SoundFont-URL (SF2/SF3, optional)"

#: src/components/AdminSettings.vue
msgid "Leave empty: the app delivers the SoundFont itself. Only fill in to have the browser load a different SoundFont directly - that address must then be reachable from the browser and allow CORS."
msgstr "Leer lassen: Die App liefert das SoundFont selbst aus. Nur ausfüllen, damit der Browser ein anderes SoundFont direkt lädt – diese Adresse muss dann vom Browser aus erreichbar sein und CORS erlauben."

#: src/components/AdminSettings.vue
msgid "Rehearsal and concert"
msgstr "Probe und Konzert"

#: src/components/AdminSettings.vue
msgid "Leaders and “Follow me” (the leader sends position, loop and starting note to all devices)"
msgstr "Leitung und „Folgt mir“ (die Leitung schickt Position, Loop und Anfangston an alle Geräte)"

#: src/components/AdminSettings.vue
msgid "Polling interval for “Follow me” (ms)"
msgstr "Abfrageintervall für „Folgt mir“ (ms)"

#: src/components/AdminSettings.vue

<?xml version="1.0" encoding="utf-8"?>
<!--
	Reine Unit-Tests gegen Interface-Mocks - bewusst KEIN Bootstrap der
	echten Nextcloud-Instanz (Codereview Phase 23/Schritt 2, Befund B5).
	`nextcloud/ocp` liefert die OCP-Schnittstellen als dev-Abhaengigkeit,
	composer.json haengt sie fuer die Laufzeit in `autoload-dev` ein (das
	Paket selbst deklariert keinen Autoload, es ist fuer Psalm gedacht).

	Damit laufen diese Tests in Sekunden und ohne Container - genau die
	Eigenschaft, die sie in CI und vor dem grossen Umbau aus Schritt 6
	brauchbar macht. Was echte Nextcloud-Integration braucht (Routen,
	Migrationen, IAppData), bleibt weiterhin Sache des Durchlaufs gegen die
	Testinstanz; siehe scoreview/README.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
	bootstrap="../vendor/autoload.php"
	colors="true"
	cacheDirectory="../.phpunit.cache"
	failOnWarning="true"
	failOnRisky="true"
	beStrictAboutOutputDuringTests="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">./Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">../lib</directory>
		</include>
	</source>
</phpunit>

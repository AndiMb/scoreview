{
	"name": "scoreview",
	"private": true,
	"description": "ScoreView für Nextcloud",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"build": "webpack --node-env production --progress",
		"dev": "webpack --node-env development --progress",
		"l10n:extract": "node tools/l10n.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
		"stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
		"test": "vitest run",
		"watch": "webpack --node-env development --progress --watch"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
	],
	"dependencies": {
		"@nextcloud/axios": "^2.5.0",
		"@nextcloud/files": "^4.0.0",
		"@nextcloud/initial-state": "^3.0.0",
		"@nextcloud/l10n": "^3.1.0",
		"@nextcloud/router": "^3.1.0",
		"@nextcloud/vue": "^9.11.0",
		"dompurify": "^3.4.14",
		"spessasynth_lib": "^4.3.14",
		"stb-vorbis": "^0.0.6",
		"vue": "^3.5.42",
		"vue-material-design-icons": "^5.3.1"
	},
	"devDependencies": {
		"@nextcloud/babel-config": "^1.3.0",
		"@nextcloud/browserslist-config": "^3.1.2",
		"@nextcloud/eslint-config": "^9.0.1",
		"@nextcloud/stylelint-config": "^3.2.2",
		"@nextcloud/webpack-vue-config": "^7.0.4",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^10.9.1",
		"jsdom": "^30.0.1",
		"stylelint": "^17.14.1",
		"vitest": "^4.1.10",
		"vue-loader": "^17.4.2"
	},
	"engines": {
		"node": "^22.0.0 || ^24.0.0",
		"npm": "^10.0.0 || ^11.0.0"
	}
}

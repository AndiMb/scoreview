{
	"name": "scoreview",
	"private": true,
	"description": "ScoreView für Nextcloud",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"audit": "node tools/audit.mjs",
		"build": "node tools/l10n.mjs build && webpack --node-env production --progress",
		"dev": "node tools/l10n.mjs build && webpack --node-env development --progress",
		"docs:l10n": "node tools/docs-l10n.mjs",
		"l10n:build": "node tools/l10n.mjs build",
		"l10n:check": "node tools/l10n.mjs check",
		"l10n:extract": "node tools/l10n.mjs extract",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
		"stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
		"test": "vitest run",
		"watch": "node tools/l10n.mjs build && webpack --node-env development --progress --watch"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
	],
	"dependencies": {
		"@breezystack/lamejs": "^1.2.7",
		"@nextcloud/axios": "^2.5.0",
		"@nextcloud/dialogs": "^7.5.0",
		"@nextcloud/files": "^4.0.0",
		"@nextcloud/initial-state": "^3.0.0",
		"@nextcloud/l10n": "^3.1.0",
		"@nextcloud/notify_push": "^1.4.0",
		"@nextcloud/router": "^3.1.0",
		"@nextcloud/vue": "^9.13.1",
		"dompurify": "^3.4.17",
		"spessasynth_lib": "^4.3.14",
		"stb-vorbis": "^0.0.6",
		"vue": "^3.5.44",
		"vue-material-design-icons": "^5.4.0"
	},
	"devDependencies": {
		"@nextcloud/browserslist-config": "^3.1.2",
		"@nextcloud/eslint-config": "^9.0.1",
		"@nextcloud/stylelint-config": "^3.2.2",
		"@nextcloud/webpack-vue-config": "^7.1.0",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^10.13.0",
		"jsdom": "^30.1.3",
		"stylelint": "^17.15.0",
		"vitest": "^5.0.5",
		"vue-loader": "^17.4.2"
	},
	"engines": {
		"node": "^24.0.0",
		"npm": "^10.0.0 || ^11.0.0"
	}
}

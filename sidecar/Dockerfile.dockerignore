# Build context of sidecar/Dockerfile is the repository root (see there).
# Everything is left out except what the Dockerfile copies.
*
!sidecar/Dockerfile
!sidecar/entrypoint.sh
!sidecar/wsgi.py
!sidecar/scoreview_sidecar/*.py
!scoreview/converter/package.json
!scoreview/converter/package-lock.json
!scoreview/converter/convert.mjs
!scoreview/converter/lib/*.mjs
scoreview/converter/lib/*.test.mjs
!scoreview/converter/*.mscz
